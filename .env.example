# Greenway Scraper - Environment Variables

# Optional: Database connection for direct staging table import
# If not provided, scraper will only export to JSON files
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=greenway_scraper
DB_USER=postgres
DB_PASSWORD=your_password_here

# Optional: Laravel backend API endpoint
# For posting scraped data directly to the backend
API_URL=http://127.0.0.1:8000
API_TOKEN=your_api_token_here

# Optional: Proxy configuration (if needed)
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080

# Optional: User agent override
# USER_AGENT=GreenwayScraper/1.0

# Optional: Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
